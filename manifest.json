{
  "manifest_version": 3,
  "name": "Assistente Web Acessível",
  "version": "0.2.0",
  "description": "Fundação do MVP de um assistente web para pessoas com deficiência visual.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://geocoding-api.open-meteo.com/*",
    "https://api.open-meteo.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Ativar Jarvis"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "activate-assistant": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Ativar o assistente web acessível"
    }
  }
}
